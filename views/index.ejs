<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Open Library - MAKE LIBRARY</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;500;600;700&family=Georgia&display=swap" rel="stylesheet">
    <style>
        :root {
            --ol-bg: #e8e3d9;
            --ol-header-bg: #292929;
            --ol-card-bg: #fbf0d9;
            --ol-blue-btn: #0277bd;
            --ol-text-dark: #333333;
            --ol-border: #d0c8b6;
        }

        body {
            background-color: var(--ol-bg);
            font-family: 'Kantumruy Pro', sans-serif;
            color: var(--ol-text-dark);
            margin: 0;
            padding: 0;
        }

        /* Top Internet Archive Bar */
        .ia-top-bar {
            background-color: var(--ol-header-bg);
            color: #ffffff;
            padding: 6px 25px;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .ia-top-bar a {
            color: #ffffff;
            text-decoration: none;
        }
        .ia-top-bar a:hover {
            text-decoration: underline;
        }

        /* Open Library Header */
        .ol-navbar {
            background-color: #f5f0eb;
            border-bottom: 1px solid var(--ol-border);
            padding: 10px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .ol-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #111;
        }
        .ol-brand-title {
            font-family: 'Georgia', serif;
            font-size: 1.6rem;
            font-weight: bold;
            letter-spacing: -0.5px;
        }
        .ol-brand-badge {
            background-color: #0277bd;
            color: white;
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 3px;
            text-transform: uppercase;
        }

        .ol-search-box {
            background: #ffffff;
            border: 1px solid #ccc;
            border-radius: 4px;
            display: flex;
            align-items: center;
            width: 380px;
            padding: 4px 10px;
        }
        .ol-search-box input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 0.9rem;
        }

        /* Page Container */
        .ol-container {
            max-width: 1150px;
            margin: 20px auto;
            padding: 0 15px;
        }

        .main-heading {
            font-family: 'Georgia', serif;
            font-size: 1.8rem;
            font-weight: bold;
            color: #222;
            margin-bottom: 20px;
        }

        /* Feature Cards Row */
        .feature-cards-wrapper {
            position: relative;
            margin-bottom: 35px;
        }
        .feature-card {
            background-color: #f7f3ec;
            border: 1px solid var(--ol-border);
            border-radius: 8px;
            padding: 18px;
            height: 100%;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
        }
        .feature-card-icon {
            font-size: 2.5rem;
            color: #444;
            flex-shrink: 0;
        }
        .feature-card h6 {
            font-weight: 700;
            margin-bottom: 4px;
            color: #111;
        }
        .feature-card p {
            font-size: 0.82rem;
            color: #666;
            margin: 0;
            line-height: 1.3;
        }

        .slider-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            background: #ffffff;
            border: 1px solid #ccc;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            color: #0277bd;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }
        .arrow-left { left: -18px; }
        .arrow-right { right: -18px; }

        /* Browse Stacks Section */
        .stacks-title {
            font-family: 'Georgia', serif;
            font-size: 1.4rem;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .category-stack-card {
            background: #fdfbf7;
            border: 1px solid var(--ol-border);
            border-radius: 8px;
            padding: 12px 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            height: 100%;
        }
        .category-stack-card:hover {
            border-color: #0277bd;
            transform: translateY(-2px);
        }
        .category-stack-card.active {
            border: 2px solid #0277bd;
            background: #ffffff;
        }
        .stack-icon-graphic {
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: #b45309;
            margin-bottom: 6px;
        }
        .category-stack-card span {
            font-size: 0.85rem;
            font-weight: 600;
            color: #333;
        }

        /* Featured Content Box */
        .featured-content-box {
            background-color: #fbf7f0;
            border: 1px solid var(--ol-border);
            border-radius: 10px;
            padding: 25px;
            margin-top: 15px;
            position: relative;
        }
        .featured-header-title {
            font-family: 'Georgia', serif;
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .featured-sublinks {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 25px;
        }
        .featured-sublinks a {
            color: #0277bd;
            text-decoration: underline;
            margin-right: 12px;
        }

        .section-subheading {
            font-family: 'Georgia', serif;
            font-size: 1.2rem;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .see-all-link {
            font-size: 0.85rem;
            color: #0277bd;
            text-decoration: none;
            font-weight: normal;
        }

        /* Book Gallery Item (Open Library Cover) */
        .ol-book-card {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .ol-cover-wrapper {
            width: 100%;
            height: 220px;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 2px 4px 10px rgba(0,0,0,0.15);
            background: #ddd;
            margin-bottom: 12px;
            position: relative;
        }
        .ol-cover-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .ol-cover-placeholder {
            width: 100%;
            height: 100%;
            padding: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
            text-align: center;
        }
        .btn-ol-action {
            width: 100%;
            background-color: var(--ol-blue-btn);
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 6px 0;
            font-size: 0.85rem;
            font-weight: bold;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: background 0.2s;
        }
        .btn-ol-action:hover {
            background-color: #01579b;
            color: #ffffff;
        }
        .btn-ol-secondary {
            background-color: #ffffff;
            color: #333;
            border: 1px solid #ccc;
        }
        .btn-ol-secondary:hover {
            background-color: #f1f1f1;
            color: #111;
        }
    </style>
</head>
<body>

    <!-- Top Bar -->
    <div class="ia-top-bar">
        <div>
            <i class="bi bi-bank me-2"></i> <strong>INTERNET ARCHIVE</strong>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <a href="#" class="text-danger font-monospace"><i class="bi bi-heart-fill"></i> Donate</a>
            <a href="#"><i class="bi bi-globe"></i> English</a>
        </div>
    </div>

    <!-- Header Navbar -->
    <header class="ol-navbar">
        <a href="/" class="ol-brand">
            <i class="bi bi-book-half fs-2 text-warning"></i>
            <span class="ol-brand-title">OPEN LIBRARY</span>
        </a>

        <div class="d-flex align-items-center gap-4">
            <a href="#" class="text-dark text-decoration-none fw-semibold small"><i class="bi bi-bookmark-fill text-secondary"></i> My Books</a>
            <a href="#" class="text-dark text-decoration-none fw-semibold small"><i class="bi bi-journal-text me-1"></i> Browse <i class="bi bi-chevron-down small"></i></a>
            
            <div class="ol-search-box">
                <input type="text" id="searchInput" placeholder="Search">
                <i class="bi bi-search text-muted"></i>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/admin/login" class="text-dark fs-5" title="Admin Login"><i class="bi bi-person-circle"></i></a>
                <i class="bi bi-list fs-4 text-dark ms-1 cursor-pointer"></i>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="ol-container">

        <h2 class="main-heading">Welcome to Open Library</h2>

        <!-- Feature Cards (3 Top Banners) -->
        <div class="feature-cards-wrapper">
            <div class="slider-arrow arrow-left"><i class="bi bi-chevron-left"></i></div>
            <div class="slider-arrow arrow-right"><i class="bi bi-chevron-right"></i></div>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="bi bi-laptop feature-card-icon"></i>
                        <div>
                            <h6>Read Free Library Books Online</h6>
                            <p>Millions of books available through Controlled Digital Lending</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="bi bi-calendar-check feature-card-icon"></i>
                        <div>
                            <h6>Set a Yearly Reading Goal</h6>
                            <p>Learn how to set a yearly reading goal and track what you read</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="feature-card">
                        <i class="bi bi-bookshelf feature-card-icon"></i>
                        <div>
                            <h6>Keep Track of your Favorite Books</h6>
                            <p>Organize your Books using Lists & the Reading Log</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Browse the stacks -->
        <h4 class="stacks-title">Browse the stacks</h4>
        <div class="row g-2 mb-4">
            <div class="col">
                <div class="category-stack-card active">
                    <div class="stack-icon-graphic"><i class="bi bi-star-fill text-danger"></i></div>
                    <span>Featured</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-ghost text-dark"></i></div>
                    <span>Horror</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-lightning-charge-fill text-warning"></i></div>
                    <span>Thriller</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-hourglass-split text-secondary"></i></div>
                    <span>History</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-person-badge-fill text-success"></i></div>
                    <span>Biography</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-rocket-takeoff-fill text-primary"></i></div>
                    <span>Sci-Fi</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-heart-fill text-danger"></i></div>
                    <span>Romance</span>
                </div>
            </div>
            <div class="col">
                <div class="category-stack-card">
                    <div class="stack-icon-graphic"><i class="bi bi-search-heart text-info"></i></div>
                    <span>Mystery</span>
                </div>
            </div>
        </div>

        <!-- Featured Section Container -->
        <div class="featured-content-box">
            <h3 class="featured-header-title">Featured</h3>
            <div class="featured-sublinks">
                Jump to <a href="#">What's new</a> <a href="#">Books we love</a> <a href="#">Classics</a> <a href="#">Most wanted</a>
            </div>

            <div class="section-subheading">
                <span>Trending</span>
                <a href="#" class="see-all-link">See all <i class="bi bi-chevron-right"></i></a>
            </div>

            <!-- Dynamic Books Loaded from Local API -->
            <div class="row g-4" id="booksGrid">
                <div class="col-12 text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Loading books from Local API...</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Script to Fetch Data from Local API (/api/books) -->
    <script>
        async function loadLocalAPIBooks() {
            try {
                // ហៅកាន់ Local API ផ្ទាល់ខ្លួន (/api/books)
                let response = await fetch('/api/books');
                let data = await response.json();

                let grid = document.getElementById('booksGrid');

                if (data.success && data.books.length > 0) {
                    grid.innerHTML = '';
                    data.books.forEach((book, index) => {
                        // កំណត់ពណ៌ Gradient ក្របសៀវភៅតាមប្រភេទ
                        let coverBg = 'linear-gradient(135deg, #1e3a8a, #3b82f6)';
                        if (index % 3 === 0) coverBg = 'linear-gradient(135deg, #065f46, #10b981)';
                        if (index % 3 === 1) coverBg = 'linear-gradient(135deg, #9a3412, #f97316)';

                        grid.innerHTML += `
                            <div class="col-lg-2 col-md-3 col-6 book-item">
                                <div class="ol-book-card">
                                    <div class="ol-cover-wrapper">
                                        <div class="ol-cover-placeholder" style="background: ${coverBg}">
                                            <div class="text-start small opacity-75 font-monospace">#${index + 1}</div>
                                            <div>
                                                <div class="fw-bold fs-6 mb-1 text-truncate">${book.title}</div>
                                                <div class="small opacity-75 text-truncate">${book.author || 'Unknown'}</div>
                                            </div>
                                            <div class="text-end small opacity-50"><i class="bi bi-book"></i></div>
                                        </div>
                                    </div>
                                    <a href="/books/read/${book.id}" target="_blank" class="btn-ol-action ${index % 2 === 0 ? '' : 'btn-ol-secondary'}">
                                        ${index % 2 === 0 ? 'Borrow' : 'Read'}
                                    </a>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    grid.innerHTML = `
                        <div class="col-12 text-center py-4 text-muted">
                            <p>No books available in local database.</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('Error fetching Local API:', error);
                document.getElementById('booksGrid').innerHTML = `
                    <div class="col-12 text-center py-4 text-danger">
                        <p>Failed to connect to Local API (/api/books)</p>
                    </div>
                `;
            }
        }

        // Live Search Filter
        document.getElementById('searchInput').addEventListener('keyup', function() {
            let filter = this.value.toLowerCase();
            let items = document.querySelectorAll('.book-item');
            items.forEach(item => {
                let text = item.innerText.toLowerCase();
                item.style.display = text.includes(filter) ? '' : 'none';
            });
        });

        // Initialize API Call
        loadLocalAPIBooks();
    </script>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>